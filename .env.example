# npm run dev uses local browser storage by default.
VITE_DATA_PROVIDER=local
VITE_LAYOUT_PROVIDER=rules

# Optional hosted Supabase project. Use the client publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# CloudBase self-hosting: see cloudbase/README.md. Use your own public client key.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=

# Optional AMap JS API for map selection. Browser configuration is public.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
